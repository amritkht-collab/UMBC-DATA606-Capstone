# Copy this file to `.env` and fill in real values. Never commit `.env`.

ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# PubMed Entrez requires a contact email, not a key
ENTREZ_EMAIL=

# Claude model defaults
CLAUDE_MODEL_MAIN=claude-opus-4-5
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_DEV=claude-sonnet-4-5

# Local paths
CHROMA_DB_DIR=./chroma_store
SESSIONS_DB_PATH=./sessions.db
